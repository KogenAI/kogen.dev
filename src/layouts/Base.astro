---
import css from '../styles/global.css?raw';
interface Props { title?: string; description?: string; }
const {title = 'Kogen — Shape the feature. Leave the build to Kogen.', description = 'Make the product and UX decisions that define the feature. Kogen handles the implementation, checking, independent review, rework, and resulting commit.'} = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://kogen.dev').href;
const socialImage = new URL('/og.png', 'https://kogen.dev').href;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={socialImage}/><meta property="og:image:width" content="1280"/><meta property="og:image:height" content="640"/><meta property="og:image:alt" content="Shape the feature. Leave the build to Kogen."/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={socialImage}/><meta name="twitter:image:alt" content="Shape the feature. Leave the build to Kogen."/><meta name="robots" content="index, follow"/><link rel="icon" href="/favicon.svg"/><style is:inline set:html={css}></style><script is:inline id="kogen-analytics">if (location.hostname === 'kogen.dev' || location.hostname === 'www.kogen.dev') {window.plausible=window.plausible||function(){(window.plausible.q=window.plausible.q||[]).push(arguments)};window.plausible.init=window.plausible.init||function(i){window.plausible.o=i||{}};window.plausible.init();var s=document.createElement('script');s.async=true;s.src='https://plausible.io/js/pa-YbJeNK89jzsIZPPvo5bQx.js';document.head.appendChild(s);}</script></head><body><a class="skip" href="#main">Skip to content</a><header class="wrap"><a class="brand" href="/" aria-label="Kogen home"><img src="/brand/kogen-wordmark-black.svg" width="104" height="40" alt="Kogen" /></a><nav aria-label="Main navigation"><a href="/#how-it-works">How it works</a><a href="/announcements/">Announcements</a><a href="/origins/">Origins</a></nav></header><slot/><footer class="wrap"><div><p>Made by <a href="https://almirsarajcic.com">Almir Sarajčić</a></p><a href="mailto:contact@kogen.dev">contact@kogen.dev</a></div><div><a href="https://www.apache.org/licenses/LICENSE-2.0">Licensed under Apache 2.0</a><p>© 2026 Optimum Tech, LLC</p></div></footer></body></html>
