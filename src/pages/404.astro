---
import css from '../styles/global.css?raw';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Page not found — Kogen</title>
    <meta name="description" content="The requested page could not be found." />
    <link rel="icon" href="/favicon.svg" />
    <style is:inline set:html={css}></style>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="wrap">
      <a class="brand" href="/" aria-label="Kogen home">
        <img src="/brand/kogen-wordmark-black.svg" width="104" height="40" alt="Kogen" />
      </a>
    </header>
    <main id="main" class="wrap prose">
      <p class="eyebrow">404</p>
      <h1>That page isn’t here.</h1>
      <p class="lead">The address may have changed, or the page may never have existed.</p>
      <p><a class="button" href="/">Return to Kogen</a></p>
    </main>
  </body>
</html>
